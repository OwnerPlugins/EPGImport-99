msgstr ""

msgid "Enter shell command name."
msgstr "Ipasok ang pangalan ng utos ng shell."

msgid "Execute shell command before import EPG"
msgstr "Isagawa ang shell command bago mag-import ng EPG"

msgid "Filtering: %s Please wait!"
msgstr "Pag-filter: %s Mangyaring maghintay!"

msgid "Friday"
msgstr "Biyernes"

msgid "Hours after which the import is repeated"
msgstr "Mga oras pagkatapos kung saan ang pag-import ay paulit-ulit"

msgid "Ignore services list"
msgstr "Huwag pansinin ang listahan ng mga serbisyo"

msgid "Import"
msgstr "Mag-import"

msgid "Import failed with error: {}"
msgstr "Nabigo ang pag-import nang may error: {}"

