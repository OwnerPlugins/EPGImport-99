msgstr "ಸ್ವಯಂಚಾಲಿತ EPG ಅಪ್‌ಡೇಟ್‌ಗಾಗಿ ಸಮಯವನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ."

msgid "Standby at startup"
msgstr "ಪ್ರಾರಂಭದಲ್ಲಿ ಸ್ಟ್ಯಾಂಡ್‌ಬೈ"

msgid "Start import after booting up"
msgstr "ಬೂಟ್ ಮಾಡಿದ ನಂತರ ಆಮದು ಪ್ರಾರಂಭಿಸಿ"

msgid "Start import after resuming from standby mode."
msgstr "ಸ್ಟ್ಯಾಂಡ್‌ಬೈ ಮೋಡ್‌ನಿಂದ ಪುನರಾರಂಭಿಸಿದ ನಂತರ ಆಮದು ಪ್ರಾರಂಭಿಸಿ."

msgid "Start import after standby"
msgstr "ಸ್ಟ್ಯಾಂಡ್ಬೈ ನಂತರ ಆಮದು ಪ್ರಾರಂಭಿಸಿ"

msgid "Sunday"
msgstr "ಭಾನುವಾರ"

msgid "The waked up box will be turned into standby after automatic EPG import wake up."
msgstr "ಸ್ವಯಂಚಾಲಿತ EPG ಆಮದು ಎಚ್ಚರವಾದ ನಂತರ ಎಚ್ಚರಗೊಂಡ ಬಾಕ್ಸ್ ಅನ್ನು ಸ್ಟ್ಯಾಂಡ್‌ಬೈ ಆಗಿ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ."

msgid "This is for advanced users that are using the channel id filtering feature. If enabled, the filter rules defined into /etc/epgimport/channel_id_filter.conf will also be applied on your /etc/epgimport/custom.channels.xml file."
msgstr "ಚಾನೆಲ್ ಐಡಿ ಫಿಲ್ಟರಿಂಗ್ ವೈಶಿಷ್ಟ್ಯವನ್ನು ಬಳಸುತ್ತಿರುವ ಸುಧಾರಿತ ಬಳಕೆದಾರರಿಗಾಗಿ ಇದು. ಸಕ್ರಿಯಗೊಳಿಸಿದರೆ, /etc/epgimport/channel_id_filter.conf ಗೆ ವ್ಯಾಖ್ಯಾನಿಸಲಾದ ಫಿಲ್ಟರ್ ನಿಯಮಗಳನ್ನು ನಿಮ್ಮ /etc/epgimport/custom.channels.xml ಫೈಲ್‌ನಲ್ಲಿಯೂ ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ."

msgid "This will clear the current EPG data in memory before updating the EPG data. This allows you to always have a clean new EPG with the latest EPG data, for example in case of program changes between refresh, otherwise EPG data are cumulative."
msgstr "ಇದು EPG ಡೇಟಾವನ್ನು ನವೀಕರಿಸುವ ಮೊದಲು ಮೆಮೊರಿಯಲ್ಲಿರುವ ಪ್ರಸ್ತುತ EPG ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ. ಇತ್ತೀಚಿನ EPG ಡೇಟಾದೊಂದಿಗೆ ಯಾವಾಗಲೂ ಕ್ಲೀನ್ ಹೊಸ EPG ಅನ್ನು ಹೊಂದಲು ಇದು ನಿಮ್ಮನ್ನು ಅನುಮತಿಸುತ್ತದೆ, ಉದಾಹರಣೆಗೆ ರಿಫ್ರೆಶ್ ನಡುವೆ ಪ್ರೋಗ್ರಾಂ ಬದಲಾವಣೆಗಳ ಸಂದರ್ಭದಲ್ಲಿ, ಇಲ್ಲದಿದ್ದರೆ EPG ಡೇಟಾ ಸಂಚಿತವಾಗಿರುತ್ತದೆ."

msgid "This will turn back waked up box into deep-standby after automatic EPG import."
msgstr "ಇದು ಸ್ವಯಂಚಾಲಿತ EPG ಆಮದು ಮಾಡಿದ ನಂತರ ಎಚ್ಚರಗೊಂಡ ಬಾಕ್ಸ್ ಅನ್ನು ಡೀಪ್-ಸ್ಟ್ಯಾಂಡ್‌ಬೈ ಆಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ."

msgid "Thursday"
msgstr "ಗುರುವಾರ"

msgid "To save memory you can decide to load EPG data only  for theIPTV channels."
msgstr "ಮೆಮೊರಿಯನ್ನು ಉಳಿಸಲು ನೀವು IPTV ಚಾನಲ್‌ಗಳಿಗೆ ಮಾತ್ರ EPG ಡೇಟಾವನ್ನು ಲೋಡ್ ಮಾಡಲು ನಿರ್ಧರಿಸಬಹುದು."

msgid "To save memory you can decide to only load EPG data for the services that you have in your bouquet files."
msgstr "ಮೆಮೊರಿಯನ್ನು ಉಳಿಸಲು ನಿಮ್ಮ ಬೊಕೆ ಫೈಲ್‌ಗಳಲ್ಲಿ ನೀವು ಹೊಂದಿರುವ ಸೇವೆಗಳಿಗೆ ಮಾತ್ರ EPG ಡೇಟಾವನ್ನು ಲೋಡ್ ಮಾಡಲು ನೀವು ನಿರ್ಧರಿಸಬಹುದು."

msgid "Tuesday"
msgstr "ಮಂಗಳವಾರ"

msgid "Update Sources"
msgstr "ಮೂಲಗಳನ್ನು ನವೀಕರಿಸಿ"

msgid "Wednesday"
msgstr "ಬುಧವಾರ"

msgid "When enabled, it allows you to schedule an automatic EPG update at the given days and time."
msgstr "ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ನಿರ್ದಿಷ್ಟ ದಿನಗಳು ಮತ್ತು ಸಮಯದಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತ EPG ನವೀಕರಣವನ್ನು ನಿಗದಿಪಡಿಸಲು ನಿಮಗೆ ಅನುಮತಿಸುತ್ತದೆ."

msgid "When enabled, then you can run the desired script before starting the import, after which the import of the EPG will begin."
msgstr "ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ಆಮದು ಪ್ರಾರಂಭಿಸುವ ಮೊದಲು ನೀವು ಬಯಸಿದ ಸ್ಕ್ರಿಪ್ಟ್ ಅನ್ನು ರನ್ ಮಾಡಬಹುದು, ಅದರ ನಂತರ EPG ಯ ಆಮದು ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."

