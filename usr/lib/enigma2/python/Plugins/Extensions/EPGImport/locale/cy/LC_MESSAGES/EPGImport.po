msgstr "Wir dileu pob rhestr?"

msgid "Return to deep standby after import"
msgstr "Dychwelyd i wrth gefn dwfn ar ôl mewnforio"

msgid "Run AutoTimer after import"
msgstr "Rhedeg AutoTimer ar ôl mewnforio"

msgid "SELECT YOUR CHOICE"
msgstr "DEWISWCH EICH DEWIS"

msgid "Saturday"
msgstr "dydd Sadwrn"

