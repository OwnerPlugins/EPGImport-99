msgstr "Uingizaji wa EPG umekamilika, matukio %d"

msgid "EPG import now"
msgstr "Ingiza EPG sasa"

msgid "EPGImport"
msgstr "Uagizaji wa EPGI"

msgid "Enter shell command name."
msgstr "Ingiza jina la amri ya ganda."

msgid "Execute shell command before import EPG"
msgstr "Tekeleza amri ya ganda kabla ya kuleta EPG"

msgid "Filtering: %s Please wait!"
msgstr "Inachuja: %s Tafadhali subiri!"

msgid "Friday"
msgstr "Ijumaa"

msgid "Hours after which the import is repeated"
msgstr "Saa baada ya hapo uagizaji unarudiwa"

msgid "Ignore services list"
msgstr "Puuza orodha ya huduma"

