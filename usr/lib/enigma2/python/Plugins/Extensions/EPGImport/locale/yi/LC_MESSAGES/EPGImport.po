msgid "No source file found !"
msgstr "קיין מקור טעקע געפונען!"

msgid "Number of hours (1-23, or 0 for no repeat) after which the import is repeated. This value is not saved and will be reset when the GUI restarts."
msgstr "נומער פון שעה (1-23, אָדער 0 פֿאַר קיין איבערחזרן) נאָך וואָס די אַרייַנפיר איז ריפּיטיד. דער ווערט איז נישט געראטעוועט און וועט זיין באַשטעטיק ווען די GUI ריסטאַרט."

msgid "Path DB EPG"
msgstr "דרך דב עפּג"

msgid "Press OK"
msgstr "דרוק OK"

msgid "Really delete all list?"
msgstr "טאַקע ויסמעקן אַלע רשימה?"

msgid "Return to deep standby after import"
msgstr "צוריקקומען צו טיף סטאַנדביי נאָך אַרייַנפיר"

msgid "Run AutoTimer after import"
msgstr "לויפן אַוטאָטימער נאָך אַרייַנפיר"

msgid "SELECT YOUR CHOICE"
msgstr "אויסקלייַבן דיין ברירה"

msgid "Saturday"
msgstr "שבת"

msgid "Save"
msgstr "היט"

msgid "Select action"
msgstr "אויסקלייַבן קאַמף"

msgid "Select service to add..."
msgstr "אויסקלייַבן סערוויס צו לייגן ..."

msgid "Settings saved successfully !"
msgstr "סעטטינגס געראטעוועט הצלחה!"

msgid "Shell command name"
msgstr "שאָל באַפֿעלן נאָמען"

#, fuzzy
msgid "Show \\\\\\\\"
msgstr "ווייַזן קלאָץ"

msgid "Show log"
msgstr "ווייַזן קלאָץ"

msgid "Skip import on restart GUI"
msgstr "האָפּקען אַרייַנפיר אויף ריסטאַרט GUI"

msgid "Source EPG"
msgstr "מקור EPG"

msgid "Sources"
msgstr "קוואלן"

msgid "Sources saved successfully!"
msgstr "מקורים געראטעוועט הצלחה!"

msgid "Specify in which case the EPG must be automatically updated after the box has booted."
msgstr "ספּעציפיצירן אין וואָס פאַל די EPG מוזן זיין אויטאָמאַטיש דערהייַנטיקט נאָך די בוטיד קעסטל."

msgid "Specify the path folder for save EPG.dat file."
msgstr "ספּעציפיצירן דעם דרך טעקע פֿאַר ראַטעווען EPG.dat טעקע."

msgid "Specify the source for EPG."
msgstr "ספּעציפיצירן די מקור פֿאַר EPG."

msgid "Specify the time for the automatic EPG update."
msgstr "ספּעציפיצירן די צייט פֿאַר די אָטאַמאַטיק עפּג דערהייַנטיקן."

msgid "Standby at startup"
msgstr "סטאַנדביי ביי סטאַרטאַפּ"

msgid "Start import after booting up"
msgstr "אָנהייב אַרייַנפיר נאָך בוטינג אַרויף"

msgid "Start import after resuming from standby mode."
msgstr "אָנהייב אַרייַנפיר נאָך ריזומינג פון סטאַנדביי מאָדע."

msgid "Start import after standby"
msgstr "אָנהייב אַרייַנפיר נאָך סטאַנדביי"

msgid "Sunday"
msgstr "זונטיק"

msgid "The waked up box will be turned into standby after automatic EPG import wake up."
msgstr "די וועקן אַרויף קעסטל וועט זיין פארוואנדלען אין סטאַנדביי נאָך אָטאַמאַטיק EPG אַרייַנפיר וועקן זיך."

msgid "This is for advanced users that are using the channel id filtering feature. If enabled, the filter rules defined into /etc/epgimport/channel_id_filter.conf will also be applied on your /etc/epgimport/custom.channels.xml file."
msgstr "דאָס איז פֿאַר אַוואַנסירטע ניצערס וואָס נוצן די קאַנאַל שייַן פֿילטרירונג שטריך. אויב ענייבאַלד, די פילטער כּללים דיפיינד אין /etc/epgimport/channel_id_filter.conf וועט אויך זיין געווענדט אויף דיין /etc/epgimport/custom.channels.xml טעקע."

msgid "This will clear the current EPG data in memory before updating the EPG data. This allows you to always have a clean new EPG with the latest EPG data, for example in case of program changes between refresh, otherwise EPG data are cumulative."
msgstr "דאָס וועט ויסמעקן די קראַנט EPG דאַטן אין זכּרון איידער אַפּדייטינג די EPG דאַטן. דאָס אַלאַוז איר צו שטענדיק האָבן אַ ריין נייַע EPG מיט די לעצטע EPG דאַטן, פֿאַר בייַשפּיל אין פאַל פון פּראָגראַם ענדערונגען צווישן דערפרישן, אַנדערש EPG דאַטן זענען קיומיאַלאַטיוו."

msgid "This will turn back waked up box into deep-standby after automatic EPG import."
msgstr "דאָס וועט אומקערן די וואַקינג קעסטל אין טיף סטאַנדביי נאָך אָטאַמאַטיק עפּג אַרייַנפיר."

msgid "Thursday"
msgstr "דאנערשטאג"

msgid "To save memory you can decide to load EPG data only  for theIPTV channels."
msgstr "צו שפּאָרן זיקאָרן איר קענען באַשליסן צו לאָדן EPG דאַטן בלויז פֿאַר די IPTV טשאַנאַלז."

msgid "To save memory you can decide to only load EPG data for the services that you have in your bouquet files."
msgstr "צו שפּאָרן זיקאָרן, איר קענען באַשליסן בלויז לאָדן EPG דאַטן פֿאַר די סערוויסעס וואָס איר האָט אין דיין בוקיי טעקעס."

msgid "Tuesday"
