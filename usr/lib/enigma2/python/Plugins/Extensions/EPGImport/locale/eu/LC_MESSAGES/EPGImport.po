msgid "Add Channel"
msgstr "Gehitu kanala"

msgid "Add Provider"
msgstr "Gehitu hornitzailea"

msgid "All services provider"
msgstr "Zerbitzu hornitzaile guztiak"

msgid "Also apply \\\\\\\\"
msgstr "Aplikatu ere \\\\\\\\"

msgid "Automated EPG Importer"
msgstr "EPG inportatzaile automatizatua"

