msgstr "Stvarno izbrisati svu listu?"

msgid "Return to deep standby after import"
msgstr "Vratite se u duboku pripravnost nakon uvoza"

msgid "Run AutoTimer after import"
msgstr "Pokrenite AutoTimer nakon uvoza"

msgid "SELECT YOUR CHOICE"
msgstr "ODABERITE SVOJ IZBOR"

msgid "Saturday"
msgstr "Subota"

msgid "Save"
msgstr "Sačuvaj"

