msgstr "Thực sự xóa tất cả danh sách?"

msgid "Return to deep standby after import"
msgstr "Trở về chế độ chờ sâu sau khi nhập"

msgid "Run AutoTimer after import"
msgstr "Chạy AutoTimer sau khi nhập"

