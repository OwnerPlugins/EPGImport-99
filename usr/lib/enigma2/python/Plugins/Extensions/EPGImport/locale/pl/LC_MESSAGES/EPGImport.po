msgid "Specify in which case the EPG must be automatically updated after the box has booted."
msgstr "Określ, w którym przypadku EPG ma zostać automatycznie zaktualizowany po uruchomieniu urządzenia."

msgid "Specify the path folder for save EPG.dat file."
msgstr "Określ folder ścieżki do zapisania pliku EPG.dat."

msgid "Specify the source for EPG."
msgstr "Określ źródło EPG."

msgid "Specify the time for the automatic EPG update."
msgstr "Określ godzinę automatycznej aktualizacji EPG."

msgid "Standby at startup"
msgstr "Gotowość przy uruchomieniu"

msgid "Start import after booting up"
msgstr "Rozpocznij import po uruchomieniu"

