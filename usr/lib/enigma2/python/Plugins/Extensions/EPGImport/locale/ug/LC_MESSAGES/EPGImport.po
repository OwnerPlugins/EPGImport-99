msgid "Specify in which case the EPG must be automatically updated after the box has booted."
msgstr "ساندۇق قوزغالغاندىن كېيىن قايسى ئەھۋالدا EPG چوقۇم ئاپتوماتىك يېڭىلىنىشى كېرەكلىكىنى بەلگىلەڭ."

msgid "Specify the path folder for save EPG.dat file."
msgstr "EPG.dat ھۆججىتىنى ساقلاش ئۈچۈن يول ھۆججەت قىسقۇچىنى بەلگىلەڭ."

msgid "Specify the source for EPG."
msgstr "EPG نىڭ مەنبەسىنى بەلگىلەڭ."

msgid "Specify the time for the automatic EPG update."
msgstr "ئاپتوماتىك EPG يېڭىلاش ۋاقتىنى بەلگىلەڭ."

msgid "Standby at startup"
msgstr "قوزغالغاندا كۈتۈش"

msgid "Start import after booting up"
msgstr "قوزغىتىلغاندىن كېيىن ئىمپورت قىلىشنى باشلاڭ"

msgid "Start import after resuming from standby mode."
msgstr "كۈتۈش ھالىتىدىن ئەسلىگە كەلگەندىن كېيىن ئىمپورت قىلىشنى باشلاڭ."

msgid "Start import after standby"
msgstr "كۈتكەندىن كېيىن ئىمپورت قىلىشنى باشلاڭ"

msgid "Sunday"
msgstr "يەكشەنبە"

msgid "The waked up box will be turned into standby after automatic EPG import wake up."
msgstr "ئويغانغان ساندۇق ئاپتوماتىك EPG ئىمپورت قىلىنغاندىن كېيىن كۈتۈش ھالىتىگە ئايلىنىدۇ."

msgid "This is for advanced users that are using the channel id filtering feature. If enabled, the filter rules defined into /etc/epgimport/channel_id_filter.conf will also be applied on your /etc/epgimport/custom.channels.xml file."
msgstr "بۇ قانال id سۈزۈش ئىقتىدارىنى ئىشلىتىۋاتقان ئىلغار ئىشلەتكۈچىلەر ئۈچۈن. ئەگەر قوزغىتىلسا ، /etc/epgimport/channel_id_filter.conf غا ئېنىقلانغان سۈزگۈچ قائىدىلىرى سىزنىڭ /etc/epgimport/custom.channels.xml ھۆججىتىڭىزدىمۇ قوللىنىلىدۇ."

msgid "This will clear the current EPG data in memory before updating the EPG data. This allows you to always have a clean new EPG with the latest EPG data, for example in case of program changes between refresh, otherwise EPG data are cumulative."
msgstr "بۇ EPG سانلىق مەلۇماتلىرىنى يېڭىلاشتىن بۇرۇن نۆۋەتتىكى EPG سانلىق مەلۇماتلىرىنى ئەستە ساقلايدۇ. بۇ سىزنى ئەڭ يېڭى EPG سانلىق مەلۇماتلىرى بىلەن دائىم پاكىز يېڭى EPG غا ئىگە قىلالايسىز ، مەسىلەن يېڭىلاش ئارىسىدا پروگرامما ئۆزگەرگەن ئەھۋال ئاستىدا ، بولمىسا EPG سانلىق مەلۇماتلىرى يىغىنچاقلىنىدۇ."

msgid "This will turn back waked up box into deep-standby after automatic EPG import."
msgstr "بۇ ئاپتوماتىك EPG ئىمپورت قىلىنغاندىن كېيىن ئويغانغان قۇتىنى چوڭقۇر ھالەتكە قايتۇرىدۇ."

msgid "Thursday"
msgstr "پەيشەنبە"

msgid "To save memory you can decide to load EPG data only  for theIPTV channels."
msgstr "ئىچكى ساقلىغۇچنى تېجەش ئۈچۈن EPG سانلىق مەلۇماتلىرىنى پەقەت IPTV قاناللىرىغىلا يۈكلەشنى قارار قىلالايسىز."

msgid "To save memory you can decide to only load EPG data for the services that you have in your bouquet files."
msgstr "ئىچكى ساقلىغۇچنى تېجەش ئۈچۈن پەقەت گۈللۈك ھۆججىتىڭىزدىكى مۇلازىمەتلەر ئۈچۈن پەقەت EPG سانلىق مەلۇماتلىرىنى يۈكلەشنى قارار قىلالايسىز."

msgid "Tuesday"
msgstr "سەيشەنبە"

msgid "Update Sources"
msgstr "مەنبەنى يېڭىلاش"

msgid "Wednesday"
msgstr "چارشەنبە"

msgid "When enabled, it allows you to schedule an automatic EPG update at the given days and time."
msgstr "قوزغىتىلغاندا ، سىز بېرىلگەن كۈن ۋە ۋاقىتتا ئاپتوماتىك EPG يېڭىلاشنى ئورۇنلاشتۇرالايسىز."

msgid "When enabled, then you can run the desired script before starting the import, after which the import of the EPG will begin."
msgstr "قوزغىتىلغاندا ، ئاندىن ئىمپورتنى باشلاشتىن بۇرۇن لازىملىق قوليازمىنى ئىجرا قىلالايسىز ، ئۇنىڭدىن كېيىن EPG ئىمپورت قىلىش باشلىنىدۇ."

msgid "When in deep standby"
msgstr "چوڭقۇر كۈتۈشتە"

